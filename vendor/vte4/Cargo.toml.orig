[package]
name = "vte4"
version = "0.10.0"
authors = ["The Gtk-rs Project Developers"]
categories = ["api-bindings"]
description = "Rust bindings for the VTE Gtk4 library"
edition = "2021"
keywords = ["vte", "gtk", "gnome"]
license = "MIT"
repository = "https://gitlab.gnome.org/World/Rust/vte4-rs"

[package.metadata.docs.rs]
all-features = true

[dependencies]
libc = "0.2"
ffi = { package = "vte4-sys", path = "./sys", version = "0.10" }
io-lifetimes = "2.0.3"

[dependencies.glib]
git = "https://github.com/gtk-rs/gtk-rs-core"
version = "0.22"
branch = "0.22"

[dependencies.gio]
git = "https://github.com/gtk-rs/gtk-rs-core"
version = "0.22"
branch = "0.22"

[dependencies.pango]
git = "https://github.com/gtk-rs/gtk-rs-core"
version = "0.22"
branch = "0.22"

[dependencies.cairo-rs]
git = "https://github.com/gtk-rs/gtk-rs-core"
version = "0.22"
branch = "0.22"

[dependencies.gdk]
package = "gdk4"
git = "https://github.com/gtk-rs/gtk4-rs"
version = "0.11"
branch = "0.11"

[dependencies.gtk]
package = "gtk4"
git = "https://github.com/gtk-rs/gtk4-rs"
version = "0.11"
branch = "0.11"

[features]
default = []
v0_66 = ["ffi/v0_66"]
v0_70 = ["v0_66", "ffi/v0_70"]
v0_72 = ["v0_70", "ffi/v0_72"]
v0_74 = ["v0_72", "ffi/v0_74"]
v0_76 = ["v0_74", "ffi/v0_76"]
v0_78 = ["v0_76", "ffi/v0_78"]
v0_80 = ["v0_78", "ffi/v0_80"]
v0_82 = ["v0_80", "ffi/v0_82"]
v0_84 = ["v0_82", "ffi/v0_84"]
gtk_v4_18 = ["gtk/v4_18"]
