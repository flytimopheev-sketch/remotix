<?xml version="1.0" encoding="UTF-8"?>
<interface domain="remotix">
  <object class="GtkWindow" id="main_window">
    <property name="title">Remotix — Клиент удалённого доступа</property>
    <property name="default-width">1100</property>
    <property name="default-height">700</property>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <child>
          <object class="GtkSearchEntry" id="search_entry">
            <property name="placeholder-text">Поиск по названию, адресу, тегам…</property>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="paned">
            <property name="position">300</property>
            <child>
              <object class="GtkScrolledWindow" id="tree_scroll">
                <property name="child">
                  <object class="GtkTreeView" id="profiles_tree"/>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebook" id="connections_notebook"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
